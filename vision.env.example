# Copy to vision.env (git-ignored), edit, then load it before starting the
# gateway:   set -a; source vision.env; set +a; gateway/run.sh
# Nothing here is required: every value shown is the default.

# Where Python environments, model weights, jobs and the job database live.
# Must be on storage that every Slurm compute node can read and write.
# Default: a "vision-data" folder next to the repository.
# VISION_DATA_DIR=/path/to/vision-data

# Hugging Face token. Needed only to download gated weights
# (LTX-2.5: see models/ltx25/download_weights.sh).
# HF_TOKEN=

# Gateway
# MODEL_API_HOST=0.0.0.0
# MODEL_API_PORT=8012
# MODEL_API_FALLBACK_PARTITION=background
# MODEL_API_SLURM_JOB_NAME_PREFIX=data-validation-
# MODEL_API_RETENTION_DAYS=7
# false (default): store no logs, inputs or outputs longer than needed.
#   Inputs are deleted when their GPU job ends; a result is deleted right
#   after it has been downloaded once (download it before it is gone!).
# true: keep everything for MODEL_API_RETENTION_DAYS, as before.
# MODEL_API_PRESERVE_JOB_DATA=false
# MODEL_API_UNUSED_UPLOAD_TTL_MINUTES=60
# MODEL_API_MAX_INFLIGHT=
